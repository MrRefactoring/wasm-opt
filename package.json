{
  "name": "wasm-opt",
  "version": "2.0.0",
  "description": "Native wasm-opt from Binaryen, delivered as a platform package",
  "keywords": [
    "wasm",
    "wasm-opt",
    "binaryen",
    "webassembly",
    "optimize"
  ],
  "homepage": "https://github.com/MrRefactoring/wasm-opt#readme",
  "bugs": "https://github.com/MrRefactoring/wasm-opt/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrRefactoring/wasm-opt.git"
  },
  "license": "MIT",
  "author": "Vladislav Tupikin <mrrefactoring@yandex.ru>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "wasm-opt": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.14.0"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "vitest run --project e2e",
    "check:package": "publint && attw --pack . --profile esm-only",
    "packages:build": "node tools/build-platform-packages.ts",
    "prepublishOnly": "pnpm build && pnpm check:package"
  },
  "dependencies": {
    "tar": "^7.5.22"
  },
  "optionalDependencies": {
    "@wasm-opt/darwin-arm64": "2.0.0",
    "@wasm-opt/linux-arm64": "2.0.0",
    "@wasm-opt/linux-x64": "2.0.0",
    "@wasm-opt/win32-arm64": "2.0.0",
    "@wasm-opt/win32-x64": "2.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.13",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.5.1",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
